# Synthetic/local starting point. From service/, copy to .env and run:
# node --env-file=.env src/main.ts
# pnpm start does not automatically load .env.
BOOPY_INTERPRETER=fixture
BOOPY_SEGMENTER=none
BOOPY_DATA_DIR=.data
BOOPY_PORT=47900
BOOPY_CONNECTOR_PORT=47901
BOOPY_CONNECTOR_URL=http://127.0.0.1:47901
BOOPY_LOG=0

# Optional local interpretation (requires an installed model):
# BOOPY_INTERPRETER=ollama
# BOOPY_OLLAMA_MODEL=qwen3.6:35b-a3b-nvfp4

# Hosted interpretation is an explicit choice that sends frames to Meta:
# BOOPY_INTERPRETER=muse-spark
# BOOPY_MUSE_MODEL=muse-spark-1.3
# Prefer the private mode-0600 model-api-key file in BOOPY_DATA_DIR.
# If using an environment key instead, replace this placeholder privately:
# MODEL_API_KEY=replace-with-your-own-key
# No sponsor integrations are implemented; no sponsor variables are invented here.

# Optional local H-MEM subset recall. No external export or hosted embeddings.
BOOPY_MEMORY=none

# Optional offline scene masks; all three paths must be absolute and already installed.
# BOOPY_LIVE_SCENE=local
# BOOPY_SCENE_PYTHON=/absolute/path/to/scene-venv/bin/python
# BOOPY_SCENE_DETECTOR=/absolute/path/to/grounding-dino-tiny
# BOOPY_SCENE_SEGMENTER=/absolute/path/to/sam2.1-hiera-tiny

# BOOPY_SPEECH_OUTPUT=qwen
# BOOPY_VOICE_PYTHON=/absolute/path/to/voice-venv/bin/python
# BOOPY_VOICE_MODEL=/absolute/path/to/Qwen3-TTS-1.7B-CustomVoice-8bit
